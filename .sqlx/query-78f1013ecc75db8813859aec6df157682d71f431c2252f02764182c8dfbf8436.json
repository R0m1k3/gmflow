{
  "db_name": "PostgreSQL",
  "query": "select d.id, d.type as \"type!\", d.numero, d.date_document, d.numero_commande,\n                  d.montant_ht,\n                  d.remise_ht, d.annexes_ht,\n                  d.fournisseur_id, fo.nom as \"fournisseur?\",\n                  s.raison_sociale as \"societe?\", p.nom as nom_fichier\n           from document d\n           join piece_jointe p on p.id = d.piece_jointe_id\n           left join fournisseur fo on fo.id = d.fournisseur_id\n           left join societe s on s.id = d.societe_id\n           where d.id = any($1)\n             and exists (select 1 from mail_boite_vue mb join boite_mail b on b.id = mb.boite_id\n                         where mb.mail_id = d.mail_id and ($2::bigint is null or b.societe_id = $2))",
