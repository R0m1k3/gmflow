  "query": "select d.type, d.numero, coalesce(f.nom, d.fournisseur_nom) as fournisseur,\n                  d.magasin_demande_le, d.magasin_verifie_le, d.magasin_erreur\n           from document d left join fournisseur f on f.id = d.fournisseur_id\n           where d.id = $1",
