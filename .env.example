# Variables de la stack Portainer (à saisir dans Portainer, jamais à commiter).

# Clé de chiffrement des mots de passe IMAP et du jeton Claude : 32 octets en base64.
# Générer avec : openssl rand -base64 32
# En garder une copie dans un coffre : sans elle, les mots de passe IMAP et le jeton sont à ressaisir.
GMFLOW_CLE_CHIFFREMENT=

# Mot de passe PostgreSQL (lettres et chiffres seulement : il entre dans une URL).
# Générer avec : openssl rand -hex 24
POSTGRES_PASSWORD=

# Adresse publique de l'app (sert au lien du premier compte écrit dans les logs).
GMFLOW_URL_PUBLIQUE=https://gmflow.ffnancy.fr

# Nom du réseau Docker de Nginx Proxy Manager sur le VPS (docker network ls).
NPM_RESEAU=
